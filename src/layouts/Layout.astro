---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "МТО-Альянс — поставки нефтегазового оборудования и рефрижераторных контейнеров",
  description = "МТО-Альянс (MTO ALLIANCE) — проверенный поставщик нефтегазового оборудования, рефрижераторных контейнеров и вагонов. 27 лет на рынке, 6480 контрактов, поставки по всей России в кратчайшие сроки.",
} = Astro.props;

// base для ссылок на статику из public/ (учитывает подпапку /mtoalliance/ на GitHub Pages)
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={`${base}/favicon.ico`} sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="192x192" href={`${base}/favicon-192x192.png`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />

