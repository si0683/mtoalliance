---
// Шапка сайта: логотип, навигация, телефон, бургер-меню
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<header class="header" id="top">
  <div class="wrap header__inner">
    <a href="#top" class="brand" aria-label="МТО-Альянс">
      <img src={`${base}/logo.svg`} alt="MTO Alliance" class="brand__logo" />
    </a>
    <nav class="nav" id="nav">
      <a href="#about">О компании</a>
      <a href="#directions">Направления</a>
      <a href="#neftegaz">Нефтегаз</a>
      <a href="#reefer">Рефконтейнеры</a>
      <a href="#geo">География</a>
      <a href="#team">Руководство</a>
      <a href="#contacts">Контакты</a>
    </nav>
    <div class="header__actions">
      <a href="tel:88469799999" class="header__phone">8 (846) 979-99-99</a>
      <a href="#contacts" class="btn btn--sm">Оставить заявку</a>
      <button class="burger" id="burger" aria-label="Меню" aria-expanded="false"><span></span><span></span><span></span></button>
    </div>
  </div>
</header>

<style>
  .header{position:fixed;top:0;left:0;right:0;z-index:60;transition:background .3s,border-color .3s,backdrop-filter .3s;border-bottom:1px solid transparent;background:linear-gradient(180deg,rgba(6,8,11,.78),rgba(6,8,11,0))}
  .header.solid{background:rgba(10,12,15,.9);backdrop-filter:saturate(160%) blur(14px);border-bottom-color:var(--line)}
  .header__inner{display:flex;align-items:center;gap:22px;height:76px}
  .brand{flex-shrink:0}
  .nav{display:flex;gap:2px;margin-left:auto}
  .nav a{padding:.5em .7em;border-radius:8px;font-size:.92rem;font-weight:500;color:#cfd6e0;white-space:nowrap;transition:color .15s,background .15s}
  .nav a:hover{color:var(--ink);background:rgba(255,255,255,.05)}
  .header__actions{display:flex;align-items:center;gap:16px}
  .header__phone{font-weight:700;white-space:nowrap;color:var(--ink)}
  .burger{display:none;flex-direction:column;gap:5px;width:44px;height:44px;background:none;border:0;cursor:pointer;padding:10px}
  .burger span{height:2px;background:var(--ink);border-radius:2px;transition:.25s}
  .burger[aria-expanded="true"] span:nth-child(1){transform:translateY(7px) rotate(45deg)}
  .burger[aria-expanded="true"] span:nth-child(2){opacity:0}
  .burger[aria-expanded="true"] span:nth-child(3){transform:translateY(-7px) rotate(-45deg)}

  @media (max-width:860px){
    .nav{position:fixed;inset:76px 0 auto 0;flex-direction:column;gap:0;background:rgba(10,12,15,.98);backdrop-filter:blur(14px);
      border-bottom:1px solid var(--line);padding:8px var(--pad) 18px;transform:translateY(-130%);transition:transform .3s;margin-left:0}
    .nav.open{transform:none}
    .nav a{padding:14px 4px;border-bottom:1px solid var(--line);border-radius:0}
    .burger{display:flex}
    .header__phone{display:none}
  }
</style>
