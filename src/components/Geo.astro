---
// География поставок: живая интерактивная карта (логика — src/scripts/map.js)
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section class="geo" id="geo">
  <div class="wrap">
    <div class="section__head reveal">
      <span class="tag">География поставок</span>
      <h2>Поставки по всей территории России</h2>
      <p class="section__sub">Отгружаем продукцию с заводов-партнёров по всей стране — железнодорожным,
        автомобильным и авиатранспортом, с контролем груза на всём пути. Центральный офис — в Самаре.</p>
    </div>

    <div class="geomap reveal" id="geo-map">
      <div class="geomap__modes" role="group" aria-label="Вид транспорта">
        <button type="button" class="geomap__mode is-active" data-mode="all">Все маршруты</button>
        <button type="button" class="geomap__mode" data-mode="rail"><span class="dot dot--rail"></span>Ж/д</button>
        <button type="button" class="geomap__mode" data-mode="auto"><span class="dot dot--auto"></span>Авто</button>
        <button type="button" class="geomap__mode" data-mode="air"><span class="dot dot--air"></span>Авиа</button>
      </div>

      <div class="geomap__stage">
        <img class="geomap__img" src={`${base}/assets/img/rf-map.webp`} alt="Карта России — география поставок" loading="lazy" width="1500" height="882" />
        <svg class="geomap__svg" viewBox="0 0 1500 882" preserveAspectRatio="xMidYMid meet" aria-hidden="true"></svg>
        <div class="geomap__tip" id="geomap-tip" hidden></div>
      </div>

      <ul class="geomap__legend">
        <li><span class="dot dot--office"></span>Центральный офис (Самара)</li>
        <li><span class="dot dot--city"></span>Города поставок</li>
      </ul>
    </div>
  </div>
</section>

<!-- is:global: маршруты/точки/грузы SVG создаются из map.js уже после сборки
     и не получают scoped-атрибут Astro, поэтому стили карты должны быть глобальными. -->
<style is:global>
  .geo{padding:clamp(60px,8vw,120px) 0}
  .geomap__modes{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:20px}
  .geomap__mode{display:inline-flex;align-items:center;gap:8px;background:var(--panel);border:1px solid var(--line);color:var(--muted);
    font-weight:600;font-size:.9rem;padding:.6em 1.1em;border-radius:999px;cursor:pointer;transition:border-color .2s,color .2s,background .2s}
  .geomap__mode:hover{color:var(--ink);border-color:var(--line-2)}
  .geomap__mode.is-active{color:#20160a;background:linear-gradient(100deg,var(--gold-deep),var(--gold-2));border-color:transparent}
  .dot{width:10px;height:10px;border-radius:50%;display:inline-block;flex:none}
  .dot--rail{background:#e6c47a}
  .dot--auto{background:#8fb3d9}
  .dot--air{background:#f0d69a;box-shadow:0 0 0 2px rgba(240,214,154,.25)}
  .dot--office{background:var(--gold-2);box-shadow:0 0 0 3px rgba(216,178,94,.3)}
  .dot--city{background:transparent;border:2px solid var(--gold);width:11px;height:11px}
  .geomap__stage{position:relative;width:100%;border:1px solid var(--line);border-radius:16px;overflow:hidden;
    background:radial-gradient(120% 140% at 50% 20%,rgba(216,178,94,.05),transparent 60%),var(--bg)}
  .geomap__img{display:block;width:100%;height:auto;opacity:.92}
  .geomap__svg{position:absolute;inset:0;width:100%;height:100%;overflow:visible}
  .geomap__legend{display:flex;flex-wrap:wrap;gap:10px 22px;list-style:none;margin:16px 0 0;padding:0;color:var(--muted);font-size:.86rem}
  .geomap__legend li{display:flex;align-items:center;gap:8px}
  /* SVG-элементы (создаются из map.js) */
  .route{fill:none;stroke-width:1.6;opacity:.55;transition:opacity .35s}
  .route--rail{stroke:#e6c47a}
  .route--auto{stroke:#8fb3d9;stroke-dasharray:7 6}
  .route--air{stroke:#f0d69a;stroke-dasharray:1.5 7;stroke-linecap:round}
  .route.dim{opacity:.06}
  .node{fill:var(--bg-2);stroke:var(--gold);stroke-width:2;transition:transform .2s}
  .node--office{fill:var(--gold-2);stroke:#fff3d6}
  .pulse{fill:none;stroke:var(--gold-2);transform-box:fill-box;transform-origin:center;animation:mapPulse 2.6s ease-out infinite}
  .cargo{fill:#fff2cf;filter:drop-shadow(0 0 3px rgba(255,220,140,.9))}
  .node-label{fill:#f0d69a;font-size:13px;font-weight:700;font-family:system-ui,sans-serif;paint-order:stroke;stroke:rgba(8,10,13,.85);stroke-width:3px}
  @keyframes mapPulse{0%{transform:scale(1);opacity:.55}70%{transform:scale(3.2);opacity:0}100%{opacity:0}}
  .geomap__tip{position:absolute;z-index:5;transform:translate(-50%,-140%);background:rgba(10,12,15,.95);border:1px solid var(--line-2);
    color:var(--ink);font-size:.82rem;font-weight:600;padding:6px 10px;border-radius:8px;pointer-events:none;white-space:nowrap;box-shadow:var(--shadow)}
  @media (max-width:560px){ .node-label{font-size:20px} .geomap__legend{font-size:.8rem} }
  @media (prefers-reduced-motion:reduce){ .pulse{animation:none;opacity:0} }
</style>

<script>
  import "../scripts/map.js";
</script>
